    { id: 'ex-tetris', name: 'Tetris', category: 'Puzzle', imageUrl: 'https://funhtml5games.com/images/tetris.jpg', embedUrl: 'https://funhtml5games.com?embed=tetris' },
    { id: 'ex-lemmings', name: 'Lemmings', category: 'Puzzle', imageUrl: 'https://funhtml5games.com/images/lemming.png', embedUrl: 'https://funhtml5games.com?embed=lemmings' },
    { id: 'ex-animals-connect', name: 'Animals Connect', category: 'Puzzle', imageUrl: 'https://cdn.htmlgames.com/AnimalsConnect/img/icon/image-300x200.jpg', embedUrl: 'https://cdn.htmlgames.com/AnimalsConnect/index.html' },
    { id: 'ex-sushi-mahjong', name: 'Sushi Mahjong', category: 'Puzzle', imageUrl: 'https://cdn.htmlgames.com/SushiMahjong/img/loading.png', embedUrl: 'https://cdn.htmlgames.com/SushiMahjong/index.html' },
    { id: 'ex-jolly-jong', name: 'Jolly Jong Blitz', category: 'Puzzle', imageUrl: 'https://cdn.htmlgames.com/JollyJongBlitz2/img/icon/image-300x200.jpg', embedUrl: 'https://cdn.htmlgames.com/JollyJongBlitz2/index.html' },
    { id: 'ex-classic-chess', name: 'Classic Chess', category: 'Board & Card', imageUrl: 'https://cdn.htmlgames.com/Chess/img/title.png', embedUrl: 'https://cdn.htmlgames.com/Chess/index.html' },
    { id: 'ex-planet-solitaire', name: 'Planet Solitaire', category: 'Board & Card', imageUrl: 'https://cdn.htmlgames.com/PlanetSolitaire/img/menu_back.jpg', embedUrl: 'https://cdn.htmlgames.com/PlanetSolitaire/index.html' },
    { id: 'ex-hotel-escape', name: 'Hotel Escape', category: 'Horror & Escape', imageUrl: 'https://cdn.htmlgames.com/EscapeRoom-HotelEscape/img/loading.png', embedUrl: 'https://cdn.htmlgames.com/EscapeRoom-HotelEscape/index.html' },
    { id: 'ex-minicraft', name: 'Minicraft', category: 'Adventure & Sandbox', imageUrl: 'https://funhtml5games.com/images/minicraft.jpg', embedUrl: 'https://funhtml5games.com?embed=minicraft' }
  ];

  var GENRE_TABS = [
    'Action & Shooter', 'Sports', 'Endless Runner', 'Racing & Driving',
    'Platformer & Rhythm', 'Arcade & Classic', 'Puzzle', 'Board & Card',
    'Clicker & Idle', 'Horror & Escape', 'Adventure & Sandbox'
  ];

  var EXACT_GENRE_RULES = [
    { rx: /\b(basketball stars|basket random|basket bros|retro bowl|football legends|soccer|world cup|boxing|volley|baseball|tennis|golf|bowling|hockey|wrestle)\b/i, cat: 'Sports' },
    { rx: /\b(1v1\.?lol|shell shockers|krunker|bullet force|getaway shootout|time shooter|pixel shooter|gunspin|ragdoll archers|rooftop snipers|doom|space invaders|awesome tanks|counter|sniper|combat|zombie|warfare|fortzone|brawl)\b/i, cat: 'Action & Shooter' },
    { rx: /\b(slope|subway surfers|run 3|temple run|crossy road|tunnel rush|flappy|extreme run|dinosaur|dino run|canabalt|jetpack)\b/i, cat: 'Endless Runner' },
    { rx: /\b(moto x3m|drift hunters|snow rider|drive mad|polytrack|eggy car|smash karts|crazy cars|hill climb|madalin|stunt cars|racing|racer|truck|car|kart|bike|driver|taxi)\b/i, cat: 'Racing & Driving' },
    { rx: /\b(geometry dash|vex|clusterrush|dreadhead|parkour|fireboy|watergirl|sonic|mario|big tower|tiny square|stickman hook|getting over it|a dance of fire|friday night)\b/i, cat: 'Platformer & Rhythm' },
    { rx: /\b(chess|solitaire|uno|checkers|poker|blackjack|mahjong|jolly jong|connect|board|card|domino)\b/i, cat: 'Board & Card' },
    { rx: /\b(cookie clicker|clicker|idle|monkey mart|tycoon|burger clicker|case clicker|mining empire)\b/i, cat: 'Clicker & Idle' },
    { rx: /\b(granny|five nights|fnaf|freddy|backrooms|poppy|baldi|horror|scary|escape|haunted|slender)\b/i, cat: 'Horror & Escape' },
    { rx: /\b(tetris|wordle|2048|block blast|suika|watermelon|cut the rope|candy crush|bloxorz|lemmings|sudoku|pipe|match|merge|puzzle|jigsaw|minesweeper)\b/i, cat: 'Puzzle' },
    { rx: /\b(minecraft|minicraft|bloxd|among us|bitlife|riddle school|fleeing the complex|breaking the bank|vice city|gta|craft|sandbox|adventure)\b/i, cat: 'Adventure & Sandbox' },
    { rx: /\b(pacman|pac-man|frogger|angry birds|fruit ninja|pinball|breakout|snake|bubble|arcade|retro|asteroids|galaga)\b/i, cat: 'Arcade & Classic' }
  ];

  function classifyGame(g) {
    var title = String((g && g.name) || '');
    var raw = String((g && (g.rawCategory || g.category)) || '');
    for (var i = 0; i < EXACT_GENRE_RULES.length; i++) {
      if (EXACT_GENRE_RULES[i].rx.test(title)) return EXACT_GENRE_RULES[i].cat;
    }
    var low = raw.toLowerCase();
    if (/sport|ball|soccer|football|basket/.test(low)) return 'Sports';
    if (/shoot|gun|action|fight|combat|war|battle/.test(low)) return 'Action & Shooter';
    if (/run|endless|runner/.test(low)) return 'Endless Runner';
    if (/rac|driv|car|moto|bike/.test(low)) return 'Racing & Driving';
    if (/platform|rhythm|music|jump/.test(low)) return 'Platformer & Rhythm';
    if (/card|board|chess|strategy|table/.test(low)) return 'Board & Card';
    if (/click|idle|sim|tycoon/.test(low)) return 'Clicker & Idle';
    if (/horror|scary|escape|thrill/.test(low)) return 'Horror & Escape';
    if (/puzzle|brain|logic|word|match|mahjong/.test(low)) return 'Puzzle';
    if (/advent|rpg|sandbox|open/.test(low)) return 'Adventure & Sandbox';
    return 'Arcade & Classic';
  }

  function makeArtDataUrl(name, cat) {
    var palette = [['#1a74e2', '#6bd0ff'], ['#6b38fb', '#3fa0ef'], ['#0e9f6e', '#6bd0ff'], ['#e24a1a', '#ff9b6b'], ['#d92672', '#8a5cff']];
    var hash = 0; for (var i = 0; i < name.length; i++) hash = (hash * 31 + name.charCodeAt(i)) | 0;
    var pair = palette[Math.abs(hash) % palette.length];
    var cleanTitle = String(name || 'Game').replace(/[<>&"']/g, '').slice(0, 18);
    var cleanCat = String(cat || 'Game').replace(/[<>&"']/g, '').slice(0, 20);
    var svg =
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 300">' +
      '<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="' + pair[0] + '"/><stop offset="100%" stop-color="' + pair[1] + '"/></linearGradient></defs>' +
      '<rect width="300" height="300" fill="#0f1420"/>' +
      '<circle cx="245" cy="55" r="95" fill="url(#g)" opacity="0.32"/><circle cx="55" cy="245" r="110" fill="url(#g)" opacity="0.22"/>' +
      '<rect x="26" y="26" width="248" height="248" rx="28" fill="none" stroke="url(#g)" stroke-width="3" opacity="0.45"/>' +
      '<g transform="translate(150 116)" fill="none" stroke="#eef6ff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">' +
      '<rect x="-42" y="-22" width="84" height="48" rx="22" fill="url(#g)" fill-opacity="0.35"/><path d="M-22 2h12m-6-6v12m24-4h.01M24 6h.01"/></g>' +
      '<text x="150" y="198" text-anchor="middle" fill="#eef6ff" font-family="system-ui,sans-serif" font-size="22" font-weight="800">' + cleanTitle + '</text>' +
      '<text x="150" y="226" text-anchor="middle" fill="#9fb4c8" font-family="system-ui,sans-serif" font-size="14" font-weight="600">' + cleanCat + '</text></svg>';
    return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
  }

  function nameKey(name) { return String(name || '').trim().replace(/\s+/g, ' ').toLowerCase(); }
  function dedupeGames(games) {
    var seen = {}, out = [];
    games.forEach(function (g) {
      var k = nameKey(g && g.name);
      if (!k || seen[k]) return;
      seen[k] = true; out.push(g);
    });
    return out;
  }

  var playerModal = $('bm-player-modal'), playerFrame = $('bm-player-frame'), playerTitle = $('bm-player-title'), playerNewTab = $('bm-player-newtab');
  function openEmbedGame(game) { playerTitle.textContent = game.name; playerFrame.src = game.embedUrl; playerNewTab.href = game.embedUrl; playerModal.hidden = false; }
  function closeEmbedGame() { playerModal.hidden = true; playerFrame.src = 'about:blank'; if (lastPlayed && document.body.contains(lastPlayed)) lastPlayed.focus(); }
  $('bm-player-close').addEventListener('click', closeEmbedGame);
  $('bm-player-fs').addEventListener('click', function () { if (playerFrame.requestFullscreen) playerFrame.requestFullscreen().catch(function () {}); });

  var PAGE_SIZE = 24, VISIBLE_TABS = 6, FEATURED_MAX = 16, FEATURED_MIN = 10;
  var FEATURED_NAMES = ['Basketball Stars', 'Basket Random', '1v1.lol', 'Vice City', 'Geometry Dash', 'Moto X3M', 'Granny', 'Slope', 'Drift Hunters', 'Retro Bowl', 'Subway Surfers', 'Run 3', 'Crossy Road', 'Cookie Clicker', 'Flappy Bird', 'Classic Chess'];
  var gamesPanel = $('view-games'), grid = $('bm-grid'), pager = $('bm-pager'), statusEl = $('bm-status'), heading = $('bm-heading'), totalPill = $('bm-total-pill');
  var searchEl = $('bm-search'), tabsEl = $('bm-tabs'), sizeEl = $('bm-size'), prevBtn = $('bm-prev'), nextBtn = $('bm-next'), shuffleBtn = $('bm-random');
  var featured = $('bm-featured'), track = $('bm-track'), leftBtn = $('bm-left'), rightBtn = $('bm-right'), moreWrap = $('bm-more-wrap'), moreBtn = $('bm-more'), menuEl = $('bm-menu'), badge = $('bm-badge');

  var state = { page: 1, pages: 1, query: '', category: '' };
  var reqId = 0, lastPlayed = null, ready = false, tabsBuilt = false, glider = null, allCatalog = [];

  function listOf(r) { return Array.isArray(r) ? r : (r && r.games) || []; }
  function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
  function setHeading(text) { heading.textContent = text; heading.classList.remove('swap'); void heading.offsetWidth; heading.classList.add('swap'); }
  function skeleton(n) { grid.innerHTML = ''; grid.setAttribute('aria-busy', 'true'); for (var i = 0; i < n; i++) grid.appendChild(el('div', 'bm-skel')); }
  function message(title, body, isError, actionLabel, action) {
    grid.innerHTML = ''; grid.setAttribute('aria-busy', 'false'); pager.hidden = true;
    var box = el('div', 'bm-msg' + (isError ? ' error' : ''));
    box.appendChild(el('h3', null, title)); box.appendChild(el('p', null, body));
    if (actionLabel) { var b = el('button', 'bm-btn primary', actionLabel); b.type = 'button'; b.addEventListener('click', action); box.appendChild(b); }
    grid.appendChild(box);
  }

  function resolveImages(games) {
    return Promise.all(games.map(function (g) {
      if (g.imageUrl) return Promise.resolve(g.imageUrl);
      if (g.image_token && ready) return Lumin.getImageUrl(g.image_token).catch(function () { return ''; });
      return Promise.resolve('');
    }));
  }

  function makeCard(g, imgUrl, i) {
    var card = el('button', 'bm-card');
    card.type = 'button'; card.style.setProperty('--i', i); card.setAttribute('aria-label', 'Play ' + g.name);
    var wrap = el('div', 'bm-thumbwrap');
    var img = el('img', 'bm-thumb');
    var fallbackArt = makeArtDataUrl(g.name, g.classifiedCat || g.category);
    img.src = imgUrl || fallbackArt; img.alt = g.name; img.loading = 'lazy';
    img.addEventListener('error', function () { if (img.src !== fallbackArt) img.src = fallbackArt; });
    wrap.appendChild(img);
    var ov = el('span', 'bm-play-ov'); ov.setAttribute('aria-hidden', 'true');
    ov.innerHTML = '<i><svg viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg></i>';
    wrap.appendChild(ov); card.appendChild(wrap);
    attachTilt(card);
    var meta = el('div', 'bm-meta');
    meta.appendChild(el('span', 'bm-name', g.name));
    meta.appendChild(el('span', 'bm-cat', g.classifiedCat || g.category));
    card.appendChild(meta);
    card.addEventListener('click', function () { play(g, card); });
    return card;
  }

  async function renderGames(games, id) {
    var imgs = await resolveImages(games);
    if (id !== reqId) return;
    grid.innerHTML = ''; grid.setAttribute('aria-busy', 'false');
    var frag = document.createDocumentFragment();
    games.forEach(function (g, i) { frag.appendChild(makeCard(g, imgs[i], i)); });
    grid.appendChild(frag);
  }

  function updatePager() {
    pager.hidden = state.pages <= 1;
    $('bm-page').textContent = 'Page ' + state.page + ' of ' + state.pages;
    prevBtn.disabled = state.page <= 1; nextBtn.disabled = state.page >= state.pages;
  }
  function updateArrows() { leftBtn.disabled = track.scrollLeft <= 4; rightBtn.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4; }
  function slide(dir) { track.scrollBy({ left: dir * track.clientWidth * 0.85 }); }
  function norm(s) { return String(s || '').toLowerCase().replace(/[^a-z0-9]/g, ''); }
  function shuffled(arr) { var a = arr.slice(); for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }

  async function loadFeatured(reshuffle) {
    var picks = [];
    FEATURED_NAMES.forEach(function (fname) {
      var q = norm(fname);
      var match = allCatalog.filter(function (g) { return norm(g.name) === q; })[0] || allCatalog.filter(function (g) { return norm(g.name).indexOf(q) > -1; })[0];
      if (match) picks.push(match);
    });
    picks = dedupeGames(picks);
    if (picks.length < FEATURED_MIN) picks = dedupeGames(picks.concat(allCatalog)).slice(0, FEATURED_MIN);
    if (reshuffle === true) picks = shuffled(picks);
    picks = picks.slice(0, FEATURED_MAX);
    if (!picks.length) { featured.hidden = true; return; }
    var imgs = await resolveImages(picks);
    track.innerHTML = '';
    picks.forEach(function (g, i) { track.appendChild(makeCard(g, imgs[i], i)); });
    track.scrollLeft = 0; featured.hidden = !!state.query;
    requestAnimationFrame(updateArrows);
  }

  leftBtn.addEventListener('click', function () { slide(-1); });
  rightBtn.addEventListener('click', function () { slide(1); });
  track.addEventListener('scroll', updateArrows, { passive: true });
  shuffleBtn.addEventListener('click', function () { loadFeatured(true); });

  function applySize() {
    var min = +sizeEl.min, max = +sizeEl.max, v = +sizeEl.value;
    sizeEl.style.setProperty('--fill', ((v - min) / (max - min) * 100) + '%');
    gamesPanel.style.setProperty('--tile', v + 'px');
  }
  sizeEl.addEventListener('input', applySize); applySize();

  function normalizeCatalogEntry(g) { g.classifiedCat = classifyGame(g); return g; }

  async function buildUnifiedCatalog() {
    var baseList = EXTRA_EMBEDS.map(normalizeCatalogEntry);
    if (ready) {
      try {
        var first = await Lumin.getGames({ page: 1, limit: 100 });
        var luminList = listOf(first).map(normalizeCatalogEntry);
        var totalPages = Math.min(first.pages || 1, 6);
        if (totalPages > 1) {
          var restReqs = [];
          for (var p = 2; p <= totalPages; p++) restReqs.push(Lumin.getGames({ page: p, limit: 100 }).catch(function () { return []; }));
          var restRes = await Promise.all(restReqs);
          restRes.forEach(function (r) { listOf(r).forEach(function (item) { luminList.push(normalizeCatalogEntry(item)); }); });
        }
        allCatalog = dedupeGames(luminList.concat(baseList));
      } catch (e) { allCatalog = dedupeGames(baseList); }
    } else {
      allCatalog = dedupeGames(baseList);
    }

    totalPill.textContent = allCatalog.length + ' Games Ready';
    var activeCats = GENRE_TABS.filter(function (cat) { return allCatalog.some(function (g) { return g.classifiedCat === cat; }); });
    buildTabs(activeCats);
    loadFeatured();
    load();
    fetchGameMonetize();
  }

  async function fetchGameMonetize() {
    try {
      var ctrl = new AbortController(); var timer = setTimeout(function () { ctrl.abort(); }, 4000);
      var res = await fetch('https://gamemonetize.com/rssfeed.php?format=json&category=All&type=html5&popularity=newest&company=All&amount=40', { signal: ctrl.signal });
      clearTimeout(timer);
      if (!res.ok) return;
      var data = await res.json();
      if (!Array.isArray(data)) return;
      var mapped = data.map(function (g) {
        return normalizeCatalogEntry({ id: 'gm-' + g.id, name: g.title, category: g.category || 'Arcade', imageUrl: g.thumb || '', embedUrl: g.url || '' });
      }).filter(function (g) { return g.name && g.embedUrl; });
      allCatalog = dedupeGames(allCatalog.concat(mapped));
      totalPill.textContent = allCatalog.length + ' Games Ready';
      if (!state.query && state.page === 1) load();
    } catch (e) {}
  }

  async function load() {
    var id = ++reqId; skeleton(12);
    var q = state.query.toLowerCase();
    var filtered = allCatalog.filter(function (g) {
      return (!state.category || g.classifiedCat === state.category) && (!q || String(g.name || '').toLowerCase().indexOf(q) > -1);
    });
    if (q && ready) {
      try {
        var remote = listOf(await Lumin.search(state.query)).map(normalizeCatalogEntry);
        if (state.category) remote = remote.filter(function (g) { return g.classifiedCat === state.category; });
        filtered = dedupeGames(filtered.concat(remote));
      } catch (e) {}
    }
    if (id !== reqId) return;

    featured.hidden = !!state.query || !track.children.length;
    setHeading(state.query ? ('Results for “' + state.query + '”') : (state.category || 'Explore Games'));
    var total = filtered.length;
    state.pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (state.page > state.pages) state.page = 1;

    if (!total) {
      message('No games found', state.query ? 'Try a different name, or clear the search to browse everything.' : 'Nothing in this category yet.', false, 'Clear filters', clearFilters);
      statusEl.textContent = '0 games';
      return;
    }
    var startIdx = (state.page - 1) * PAGE_SIZE;
    statusEl.textContent = total + (total === 1 ? ' game found' : ' games found');
    await renderGames(filtered.slice(startIdx, startIdx + PAGE_SIZE), id);
    if (id === reqId) updatePager();
  }

  function clearFilters() { state.query = ''; state.category = ''; state.page = 1; searchEl.value = ''; syncTabs(); load(); }

  function moveGlider(hide) {
    if (!glider) return;
    var t = tabsEl.querySelector('.bm-pill[aria-selected="true"]');
    glider.classList.toggle('off', !t || !!hide || views.games.hidden);
    if (!t || views.games.hidden) return;
    glider.style.width = t.offsetWidth + 'px';
    glider.style.transform = 'translate3d(' + t.offsetLeft + 'px, 0, 0)';
    if (!glider.classList.contains('ready')) requestAnimationFrame(function () { glider.classList.add('ready'); });
  }
  window.addEventListener('resize', function () { moveGlider(); });
  function allTabs() { return Array.prototype.slice.call(tabsEl.querySelectorAll('.bm-pill')); }
  function syncTabs() {
    var inMenu = false;
    allTabs().forEach(function (t) { var on = (t.dataset.cat || '') === state.category; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
    Array.prototype.forEach.call(menuEl.querySelectorAll('button'), function (b) { var on = b.dataset.cat === state.category; b.setAttribute('aria-selected', String(on)); if (on) inMenu = true; });
    moreBtn.classList.toggle('active', inMenu);
    moveGlider(inMenu);
  }
  function selectCategory(name, focusEl) { state.category = name; state.page = 1; syncTabs(); closeMenu(); if (focusEl) focusEl.focus(); load(); }

  function buildTabs(names) {
    if (tabsBuilt || !names.length) return;
    tabsBuilt = true;
    glider = el('span', 'bm-glider'); glider.setAttribute('aria-hidden', 'true'); tabsEl.appendChild(glider);
    [''].concat(names.slice(0, VISIBLE_TABS)).forEach(function (name) {
      var b = el('button', 'bm-pill', name || 'All');
      b.type = 'button'; b.dataset.cat = name; b.setAttribute('role', 'tab');
      b.addEventListener('click', function () { selectCategory(name, null); });
      tabsEl.appendChild(b);
    });
    tabsEl.hidden = false;
    var rest = names.slice(VISIBLE_TABS);
    if (rest.length) {
      rest.forEach(function (name) {
        var b = el('button', null, name); b.type = 'button'; b.dataset.cat = name; b.setAttribute('role', 'tab');
        b.addEventListener('click', function () { selectCategory(name, moreBtn); });
        menuEl.appendChild(b);
      });
      badge.textContent = rest.length; moreWrap.hidden = false;
    }
    syncTabs();
  }

  function closeMenu() { menuEl.hidden = true; moreBtn.setAttribute('aria-expanded', 'false'); }
  moreBtn.addEventListener('click', function (e) { e.stopPropagation(); var open = menuEl.hidden; menuEl.hidden = !open; moreBtn.setAttribute('aria-expanded', String(open)); });
  document.addEventListener('click', function (e) { if (!moreWrap.contains(e.target)) closeMenu(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      if (!menuEl.hidden) { closeMenu(); moreBtn.focus(); }
      if (!playerModal.hidden) closeEmbedGame();
      proxyModal.hidden = true;
    }
  });

  async function play(game, card) {
    lastPlayed = card;
    if (game.embedUrl) { openEmbedGame(game); return; }
    try { await Lumin.loadGame(game.id); }
    catch (err) { statusEl.textContent = "Couldn't start " + game.name; }
  }

  var debounce;
  searchEl.addEventListener('input', function () {
    clearTimeout(debounce);
    debounce = setTimeout(function () { state.query = searchEl.value.trim(); state.page = 1; load(); }, 200);
  });
  prevBtn.addEventListener('click', function () { if (state.page > 1) { state.page--; load(); gamesPanel.scrollIntoView({ behavior: 'smooth' }); } });
  nextBtn.addEventListener('click', function () { if (state.page < state.pages) { state.page++; load(); gamesPanel.scrollIntoView({ behavior: 'smooth' }); } });

  async function start() {
    skeleton(12);
    if (typeof Lumin !== 'undefined' && !window.__bmSdkFailed) {
      try {
        await Lumin.init({ headless: true });
        ready = true;
        Lumin.on('gameEnd', function () { if (lastPlayed && document.body.contains(lastPlayed)) lastPlayed.focus(); });
      } catch (err) { ready = false; }
    }
    await buildUnifiedCatalog();
  }

  window.addEventListener('pagehide', function () { try { if (ready) Lumin.destroy(); } catch (e) {} });
  start();
})();
</script>
