    { id: 'ex-fruit-ninja', name: 'Fruit Ninja: Halloween', category: 'Arcade & Classic', imageUrl: 'https://funhtml5games.com/images/fruitninja-halloween.jpg', embedUrl: 'https://funhtml5games.com?embed=fruitninja-halloween' },
