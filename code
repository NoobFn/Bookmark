  document.addEventListener('pointerdown', function (e) {
    if (e.button !== 0) return;
    var el = e.target.closest(BTN_SEL);
    if (!el) return;
    lastPtrFx = performance.now();
    triggerUiFeedback(el, e.clientX, e.clientY);
  });

  document.addEventListener('click', function (e) {
    if (performance.now() - lastPtrFx < 350) return;
    var el = e.target.closest(BTN_SEL);
    if (!el) return;
    var r = el.getBoundingClientRect();
